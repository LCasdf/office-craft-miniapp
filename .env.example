# Office Craft — local env example (no secrets)
APP_ENV=local
DEBUG=true

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=oc
MYSQL_PASSWORD=oc_dev_password
MYSQL_DATABASE=office_craft

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Auth
JWT_SECRET=change-me-in-prod-use-long-random
ACCESS_TOKEN_TTL_SECONDS=7200
REFRESH_TOKEN_TTL_SECONDS=2592000

# COS / MinIO (local uses MinIO)
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=office-craft
COS_ENV_PREFIX=local

S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Limits / TTL
MAX_INFLIGHT_TASKS_PER_USER=3
UPLOAD_CREDENTIAL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=900
INPUT_TTL_SECONDS=21600
OUTPUT_TTL_SECONDS=86400
CLEANUP_INTERVAL_SECONDS=3600
ALERT_INTERVAL_SECONDS=300
ALERT_SUCCESS_RATE_MIN=0.95
ALERT_QUEUE_DEPTH_MAX=100
ALERT_WINDOW_SECONDS=900

# AI
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=
