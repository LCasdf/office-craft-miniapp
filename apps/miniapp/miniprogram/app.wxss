page {
  background: #f3f4f6;
  color: #1f2937;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue",
    "Segoe UI", sans-serif;
  box-sizing: border-box;
  min-height: 100%;
}

view,
text,
button {
  box-sizing: border-box;
}

/* 全局主色与圆角约定 */
.oc-page {
  min-height: 100vh;
  padding: 32rpx 32rpx 48rpx;
  background: #f3f4f6;
}

.oc-card {
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.oc-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
  letter-spacing: 0.5rpx;
}

.oc-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.5;
}

.oc-hint {
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 1.5;
}

/* 清除原生 button 丑陋边框 / after 虚线 */
button {
  margin: 0;
  padding: 0;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  border-radius: 14rpx !important;
  border: none !important;
  background: transparent;
}

button::after {
  border: none !important;
  content: none !important;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-primary {
  color: #ffffff !important;
  background: #2563eb !important;
  box-shadow: 0 10rpx 20rpx rgba(37, 99, 235, 0.25);
}

.btn-primary[disabled] {
  color: #ffffff !important;
  background: #93c5fd !important;
  box-shadow: none;
  opacity: 1;
}

.btn-secondary {
  color: #2563eb !important;
  background: #eff6ff !important;
}

.btn-secondary[disabled] {
  color: #93c5fd !important;
  background: #f8fafc !important;
}

.btn-ghost {
  color: #374151 !important;
  background: #ffffff !important;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.05);
}

.btn-mini {
  display: inline-flex;
  width: auto;
  height: 56rpx;
  padding: 0 28rpx;
  font-size: 24rpx;
}

.upload-zone {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 280rpx;
  padding: 40rpx 32rpx;
  border: 2rpx dashed #cbd5e1;
  border-radius: 16rpx;
  background: #f8fafc;
}

.upload-zone__icon {
  font-size: 56rpx;
  line-height: 1;
}

.upload-zone__title {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.upload-zone__desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9ca3af;
  text-align: center;
}

.file-chip {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: #eff6ff;
  color: #1e40af;
  font-size: 26rpx;
  word-break: break-all;
}
