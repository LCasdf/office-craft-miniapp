.home .hero {
  margin-bottom: 36rpx;
  padding: 8rpx 8rpx 0;
}

.tool-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 24rpx 0;
}

.tool-card {
  width: calc(50% - 12rpx);
  padding: 36rpx 28rpx 32rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.tool-card--active {
  transform: scale(0.97);
  background: #f8fafc;
}

.tool-card.is-disabled {
  opacity: 0.55;
}

.tool-card__icon {
  font-size: 48rpx;
  line-height: 1;
}

.tool-card__name {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.tool-card__desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.4;
}

.nav-row {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.nav-btn {
  flex: 1;
}
