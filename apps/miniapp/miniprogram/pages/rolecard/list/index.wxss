.cards-page {
  min-height: 100vh;
  background: #f5f5f4;
  padding-bottom: 48rpx;
}

.top-bar {
  display: flex;
  justify-content: center;
  padding-top: 8rpx;
}

.create-btn {
  margin: 0;
  min-width: 280rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1c1917;
  background: #ffffff;
  border-radius: 999rpx !important;
  box-shadow: 0 6rpx 20rpx rgba(28, 25, 23, 0.06);
  border: 1rpx solid #e7e5e4;
}

.create-btn::after {
  border: none;
}

.top-hint {
  margin-top: 20rpx;
  text-align: center;
  padding: 0 24rpx;
}

.empty-card {
  margin-top: 48rpx;
  padding: 96rpx 40rpx;
  text-align: center;
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #e7e5e4;
}

.empty-card__icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.empty-card__text {
  font-size: 30rpx;
  color: #78716c;
  margin-bottom: 8rpx;
}

.list {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.item {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(28, 25, 23, 0.04);
  border: 1rpx solid #e7e5e4;
  padding-bottom: 24rpx;
}

.item__cover {
  position: relative;
  height: 420rpx;
  background: #1c1917;
}

.item__img {
  width: 100%;
  height: 420rpx;
  display: block;
}

.item__placeholder {
  height: 420rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  text-align: center;
}

.item__placeholder-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #e7e5e4;
  margin-bottom: 12rpx;
}

.item__placeholder-sub {
  font-size: 22rpx;
  color: #a8a29e;
  line-height: 1.4;
}

.item__badge {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  padding: 6rpx 16rpx;
  font-size: 20rpx;
  color: #fff;
  border-radius: 8rpx;
}

.item__badge.is-ready {
  background: rgba(13, 148, 136, 0.9);
}

.item__badge.is-draft {
  background: rgba(0, 0, 0, 0.55);
}

.item__name {
  padding: 24rpx 28rpx 4rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1917;
}

.item__meta {
  padding: 0 28rpx 8rpx;
  font-size: 24rpx;
  color: #a8a29e;
}

.item__actions {
  display: flex;
  gap: 16rpx;
  padding: 12rpx 24rpx 0;
}

.item__btn {
  flex: 1;
  margin: 0;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  border-radius: 12rpx !important;
}

.item__btn--edit {
  color: #44403c;
  background: #f5f5f4;
}

.item__btn--del {
  color: #dc2626;
  background: #fef2f2;
}

.item__btn::after {
  border: none;
}
