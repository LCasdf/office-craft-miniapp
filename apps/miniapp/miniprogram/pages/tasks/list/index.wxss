.tasks-page {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.empty-card {
  padding: 96rpx 40rpx;
  text-align: center;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.05);
}

.empty-card__icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.empty-card__text {
  font-size: 30rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
}

.empty-card__text.is-error {
  color: #dc2626;
}

.task-card {
  padding: 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 32rpx rgba(15, 23, 42, 0.06);
}

.task-card__body {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.task-card__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.task-card__type {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.35;
  word-break: break-word;
}

.task-card__file {
  font-size: 22rpx;
  color: #6b7280;
  line-height: 1.45;
  word-break: break-all;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.task-card__meta {
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.4;
}

.task-card__err {
  margin-top: 4rpx;
  max-height: 112rpx;
  overflow: hidden;
  font-size: 22rpx;
  color: #ef4444;
  line-height: 1.7;
  word-break: break-word;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.task-card__aside {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 20rpx;
  padding-top: 2rpx;
}

.task-card__status {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.2;
  background: #f3f4f6;
  color: #6b7280;
}

.status-succeeded {
  background: #dcfce7;
  color: #16a34a;
}

.status-failed {
  background: #fee2e2;
  color: #ef4444;
}

.status-queued,
.status-running,
.status-pending {
  background: #dbeafe;
  color: #2563eb;
}

.task-card__btn {
  margin: 0;
  padding: 0 28rpx;
  min-width: 160rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 14rpx !important;
  font-size: 24rpx;
  font-weight: 600;
  border: none !important;
}

.task-card__btn::after {
  border: none !important;
}

.task-card__btn--active {
  color: #ffffff !important;
  background: #2563eb !important;
  box-shadow: 0 8rpx 18rpx rgba(37, 99, 235, 0.22);
}

.task-card__btn--active:active {
  background: #1d4ed8 !important;
  opacity: 0.92;
  transform: scale(0.98);
}

.task-card__btn--disabled,
.task-card__btn[disabled] {
  color: #ffffff !important;
  background: #cbd5e1 !important;
  box-shadow: none !important;
  opacity: 1;
}

.task-card__btn--danger {
  color: #ef4444 !important;
  background: #fef2f2 !important;
  box-shadow: none;
}

.task-card__btn--danger:active {
  background: #fee2e2 !important;
  opacity: 0.92;
}

.task-card__btn--danger[disabled] {
  color: #fca5a5 !important;
  background: #fef2f2 !important;
}

.task-card__btn--ghost {
  color: #4b5563 !important;
  background: #f3f4f6 !important;
  box-shadow: none;
}

.task-card__btn--ghost:active {
  background: #e5e7eb !important;
}

.status-cancelled {
  background: #f3f4f6;
  color: #6b7280;
}
