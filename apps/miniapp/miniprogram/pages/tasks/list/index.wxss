.tasks-page {
  min-height: 100vh;
  padding-bottom: 48rpx;
  background: #f5f6f8;
}

.tasks-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  padding: 8rpx 4rpx 0;
}

.tasks-toolbar__count {
  font-size: 24rpx;
  color: #9ca3af;
}

.tasks-toolbar__clear {
  margin: 0;
  padding: 0 24rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  color: #dc2626;
  background: transparent;
  border: 1rpx solid #fecaca;
  border-radius: 999rpx;
}

.tasks-toolbar__clear::after {
  border: none;
}

.tasks-page.oc-page,
.oc-page.tasks-page {
  background: #f5f6f8;
}

.empty-card {
  margin-top: 24rpx;
  padding: 96rpx 40rpx;
  text-align: center;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 23, 42, 0.04);
}

.empty-card__icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.empty-card__text {
  font-size: 30rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
}

.empty-card__text.is-error {
  color: #dc2626;
}

.task-card {
  margin-top: 24rpx;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 23, 42, 0.05);
}

.task-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.task-card__type {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.35;
  word-break: break-word;
}

.task-card__badge {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
  background: #f3f4f6;
  color: #6b7280;
}

.task-card__badge.status-queued,
.task-card__badge.status-running,
.task-card__badge.status-pending {
  background: #e8f1ff;
  color: #2563eb;
}

.task-card__badge.status-succeeded {
  background: #e8f8ef;
  color: #16a34a;
}

.task-card__badge.status-failed {
  background: #fdecec;
  color: #ef4444;
}

.task-card__badge.is-expired,
.task-card__badge.is-expired.status-succeeded {
  background: #fff3e8;
  color: #f97316;
}

.task-card__badge.status-cancelled {
  background: #f3f4f6;
  color: #6b7280;
}

.task-card__body {
  margin-top: 24rpx;
}

.task-card__file {
  max-width: 100%;
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 1.4;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.task-card__progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.task-card__bar {
  flex: 1;
  min-width: 0;
}

.task-card__pct {
  flex-shrink: 0;
  min-width: 72rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 600;
  color: #6b7280;
  line-height: 1;
}

.task-card__meta {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.4;
}

.task-card__err {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #ef4444;
  line-height: 1.55;
  word-break: break-word;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.task-card__actions {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f1f3;
}

.task-card__btn {
  margin: 0 !important;
  padding: 0 28rpx !important;
  min-width: 152rpx;
  height: 64rpx !important;
  line-height: 64rpx !important;
  border-radius: 14rpx !important;
  font-size: 24rpx !important;
  font-weight: 600 !important;
  text-align: center;
}

.task-card__btn::after {
  border: none !important;
}

.task-card__btn--primary {
  color: #ffffff !important;
  background: #2563eb !important;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.2);
}

.task-card__btn--primary:active {
  background: #1d4ed8 !important;
  opacity: 0.92;
}

.task-card__btn--primary.is-disabled,
.task-card__btn--primary[disabled] {
  color: #ffffff !important;
  background: #c5cdd8 !important;
  box-shadow: none !important;
  opacity: 1 !important;
}

.task-card__btn--outline {
  color: #4b5563 !important;
  background: #ffffff !important;
  border: 2rpx solid #d1d5db !important;
  box-shadow: none !important;
}

.task-card__btn--outline:active {
  background: #f9fafb !important;
}

.task-card__btn--outline[disabled] {
  color: #9ca3af !important;
  background: #f9fafb !important;
  border-color: #e5e7eb !important;
  opacity: 1 !important;
}

.task-card__btn--text {
  min-width: auto;
  padding: 0 16rpx !important;
  color: #f87171 !important;
  background: transparent !important;
  box-shadow: none !important;
  font-weight: 500 !important;
}

.task-card__btn--text:active {
  color: #ef4444 !important;
  opacity: 0.85;
}

.task-card__btn--text[disabled] {
  color: #fca5a5 !important;
  background: transparent !important;
  opacity: 1 !important;
}
