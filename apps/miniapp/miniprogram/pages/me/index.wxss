.me-page {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.profile-card,
.quota-card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.04);
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 40rpx 36rpx;
}

.avatar {
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #eff6ff;
  color: #2563eb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.profile-card__body {
  flex: 1;
  min-width: 0;
}

.profile-card__name {
  font-size: 36rpx;
  font-weight: 700;
  color: #111111;
  line-height: 1.35;
}

.profile-card__desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #666666;
  line-height: 1.4;
}

.quota-card {
  padding: 40rpx 36rpx 36rpx;
}

.quota-card__label {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.4;
}

.quota-card__value {
  margin-top: 16rpx;
  font-size: 64rpx;
  font-weight: 700;
  color: #2563eb;
  line-height: 1.1;
  letter-spacing: 1rpx;
}

.quota-card__rows {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.quota-card__row {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.4;
}

.quota-card__tip {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
  font-size: 22rpx;
  color: #999999;
  line-height: 1.6;
}
