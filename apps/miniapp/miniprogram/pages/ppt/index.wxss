/* PPT 大纲生成器 — 轻量专业技术工具风 */

page {
  background: #f4f7fb;
}

.ppt-page {
  --ppt-ink: #0f172a;
  --ppt-muted: #64748b;
  --ppt-line: #e2e8f0;
  --ppt-blue: #1d4ed8;
  --ppt-blue-deep: #0b2a5b;
  --ppt-cyan: #0d9488;
  --ppt-card: #ffffff;
  --ppt-bg: #f4f7fb;
  min-height: 100vh;
  padding: 8rpx 32rpx calc(200rpx + env(safe-area-inset-bottom));
  background: var(--ppt-bg);
  color: var(--ppt-ink);
}

/* Hero */
.ppt-hero {
  padding: 16rpx 8rpx 36rpx;
}

.ppt-hero__eyebrow {
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  color: var(--ppt-cyan);
}

.ppt-hero__title {
  margin-top: 12rpx;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  color: var(--ppt-blue-deep);
  line-height: 1.25;
}

.ppt-hero__sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--ppt-muted);
  line-height: 1.55;
}

.ppt-steps {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid var(--ppt-line);
  border-radius: 16rpx;
}

.ppt-steps__item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  opacity: 0.45;
}

.ppt-steps__item.is-active {
  opacity: 1;
}

.ppt-steps__num {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #e2e8f0;
  color: #475569;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 36rpx;
  text-align: center;
}

.ppt-steps__item.is-active .ppt-steps__num {
  background: var(--ppt-blue);
  color: #fff;
}

.ppt-steps__label {
  font-size: 22rpx;
  color: var(--ppt-muted);
  white-space: nowrap;
}

.ppt-steps__item.is-active .ppt-steps__label {
  color: var(--ppt-blue-deep);
  font-weight: 600;
}

.ppt-steps__line {
  flex: 1;
  height: 2rpx;
  margin: 0 12rpx;
  background: var(--ppt-line);
}

/* Cards */
.ppt-card {
  margin-bottom: 24rpx;
  padding: 32rpx 28rpx;
  background: var(--ppt-card);
  border-radius: 20rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.95);
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.04);
}

.ppt-card__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.ppt-card__title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ppt-blue-deep);
}

.ppt-card__hint {
  font-size: 22rpx;
  color: #94a3b8;
}

.ppt-topic {
  width: 100%;
  min-height: 160rpx;
  padding: 28rpx 28rpx;
  box-sizing: border-box;
  background: #f8fafc;
  border: 2rpx solid #dbe3ef;
  border-radius: 16rpx;
  font-size: 32rpx;
  line-height: 1.55;
  color: var(--ppt-ink);
}

.ppt-topic__ph {
  color: #94a3b8;
  font-size: 30rpx;
}

.ppt-param {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.ppt-param--last {
  border-bottom: none;
  padding-bottom: 0;
}

.ppt-param__label {
  margin-bottom: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #475569;
  letter-spacing: 1rpx;
}

.ppt-param__row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.ppt-param__note {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.ppt-stepper {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  background: #eff6ff;
  color: var(--ppt-blue);
  font-size: 36rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 64rpx;
  text-align: center;
}

.ppt-stepper__value {
  min-width: 64rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ppt-blue-deep);
}

.ppt-chips {
  white-space: nowrap;
  width: 100%;
}

.ppt-chips--wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  white-space: normal;
}

.ppt-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  padding: 0 28rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  border: 1rpx solid var(--ppt-line);
  color: #475569;
  font-size: 24rpx;
}

.ppt-chips--wrap .ppt-chip {
  margin-right: 0;
}

.ppt-chip.is-on {
  background: #eff6ff;
  border-color: #93c5fd;
  color: var(--ppt-blue);
  font-weight: 600;
}

.ppt-field {
  width: 100%;
  margin-top: 16rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  background: #f8fafc;
  border: 1rpx solid var(--ppt-line);
  border-radius: 14rpx;
  font-size: 28rpx;
  color: var(--ppt-ink);
}

.ppt-field--area {
  min-height: 180rpx;
  line-height: 1.5;
}

/* Primary CTA */
.ppt-btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  margin: 8rpx 0 36rpx;
  border-radius: 18rpx !important;
  background: linear-gradient(135deg, #1d4ed8 0%, #0ea5e9 100%) !important;
  color: #ffffff !important;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  box-shadow: 0 14rpx 28rpx rgba(29, 78, 216, 0.28);
}

.ppt-btn-primary.is-busy,
.ppt-btn-primary[disabled] {
  opacity: 0.72;
  box-shadow: none;
}

/* Section labels */
.ppt-section-label {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 8rpx 8rpx 20rpx;
}

.ppt-section-label--preview {
  margin-top: 36rpx;
}

.ppt-section-label__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ppt-blue-deep);
}

.ppt-section-label__meta {
  font-size: 22rpx;
  color: #94a3b8;
}

/* Outline cards */
.ppt-outline-card {
  margin-bottom: 16rpx;
  background: var(--ppt-card);
  border-radius: 18rpx;
  border: 1rpx solid var(--ppt-line);
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.03);
  overflow: hidden;
}

.ppt-outline-card.is-open {
  border-color: #bfdbfe;
  box-shadow: 0 10rpx 24rpx rgba(29, 78, 216, 0.08);
}

.ppt-outline-card__main {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 28rpx 24rpx;
}

.ppt-outline-card__idx {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: #0b2a5b;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 48rpx;
  text-align: center;
  flex-shrink: 0;
}

.ppt-outline-card__body {
  flex: 1;
  min-width: 0;
}

.ppt-outline-card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ppt-ink);
  line-height: 1.35;
}

.ppt-outline-card__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ppt-muted);
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.ppt-outline-card__chev {
  flex-shrink: 0;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ppt-blue);
  font-weight: 600;
}

.ppt-outline-card__edit {
  padding: 0 24rpx 28rpx;
  border-top: 1rpx solid #f1f5f9;
}

.ppt-outline-card__edit .ppt-field {
  margin-top: 20rpx;
}

/* Preview slides */
.ppt-preview {
  width: 100%;
  white-space: nowrap;
  padding-bottom: 8rpx;
}

.ppt-slide {
  display: inline-flex;
  flex-direction: column;
  width: 280rpx;
  height: 168rpx;
  margin-right: 16rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  background: linear-gradient(160deg, #0b2a5b 0%, #1e3a5f 55%, #0f766e 140%);
  border-radius: 14rpx;
  border: 2rpx solid transparent;
  vertical-align: top;
  overflow: hidden;
}

.ppt-slide.is-focus {
  border-color: #5eead4;
  box-shadow: 0 8rpx 20rpx rgba(13, 148, 136, 0.25);
}

.ppt-slide__bar {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.55);
  margin-bottom: 10rpx;
}

.ppt-slide__title {
  font-size: 22rpx;
  font-weight: 700;
  color: #f8fafc;
  line-height: 1.3;
  margin-bottom: 10rpx;
  white-space: normal;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.ppt-slide__line {
  font-size: 18rpx;
  color: rgba(226, 232, 240, 0.82);
  line-height: 1.35;
  white-space: normal;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Dock */
.ppt-footer-spacer {
  height: 24rpx;
}

.ppt-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(244, 247, 251, 0.94);
  border-top: 1rpx solid var(--ppt-line);
  backdrop-filter: blur(12px);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ppt-dock__hint {
  font-size: 22rpx;
  color: #94a3b8;
  text-align: center;
}

.ppt-btn-export {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 92rpx;
  border-radius: 18rpx !important;
  background: var(--ppt-blue-deep) !important;
  color: #ffffff !important;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 24rpx rgba(11, 42, 91, 0.28);
}

.ppt-btn-export[disabled] {
  opacity: 0.7;
  box-shadow: none;
}
