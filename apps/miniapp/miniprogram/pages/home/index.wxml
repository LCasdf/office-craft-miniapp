<view class="oc-page home">
  <view class="hero">
    <view class="oc-title">文匠工具</view>
    <view class="oc-sub">文档处理与角色创作，各归其位</view>
  </view>

  <view class="section">
    <view class="section__head">PDF 相关功能</view>
    <view class="tool-grid">
      <view
        class="tool-card"
        wx:for="{{pdfTools}}"
        wx:key="id"
        hover-class="tool-card--active"
        hover-stay-time="80"
        data-url="{{item.url}}"
        bindtap="onTool"
      >
        <view class="tool-card__icon">{{item.icon}}</view>
        <view class="tool-card__name">{{item.name}}</view>
        <view class="tool-card__desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section__head">角色卡集</view>
    <view class="module-card" hover-class="module-card--active" hover-stay-time="80" bindtap="goRolecard">
      <view class="module-card__icon">🎴</view>
      <view class="module-card__body">
        <view class="module-card__name">角色卡集</view>
        <view class="module-card__desc">文字描述 → 生成角色立绘 · 存入作品库</view>
      </view>
      <view class="module-card__arrow">›</view>
    </view>
  </view>

  <view class="section">
    <view class="section__head">PPT</view>
    <view class="module-card" hover-class="module-card--active" hover-stay-time="80" bindtap="goPpt">
      <view class="module-card__icon">📊</view>
      <view class="module-card__body">
        <view class="module-card__name">PPT大纲生成器</view>
        <view class="module-card__desc">输入主题 → 结构化大纲 → 导出 pptx</view>
      </view>
      <view class="module-card__arrow">›</view>
    </view>
  </view>

  <view class="nav-row">
    <button class="btn btn-ghost nav-btn" bindtap="goTasks">任务中心</button>
    <button class="btn btn-ghost nav-btn" bindtap="goMe">我的</button>
  </view>
</view>
